{
	"schemaVersion": 1,
	"id": "framecraft",
	"version": "${version}",
	"name": "Framecraft",
	"description": "A camera for Minecraft: focal length, aperture and real depth of field.",
	"authors": ["sajibsrs"],
	"contact": {
		"homepage": "https://github.com/sajibsrs/framecraft",
		"sources": "https://github.com/sajibsrs/framecraft",
		"issues": "https://github.com/sajibsrs/framecraft/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["io.github.sajibsrs.framecraft.Framecraft"]
	},
	"mixins": ["framecraft.mixins.json"],
	"depends": {
		"fabricloader": ">=0.20.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
