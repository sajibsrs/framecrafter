{
	"schemaVersion": 1,
	"id": "framecrafter",
	"version": "${version}",
	"name": "Framecrafter",
	"description": "A camera for Minecraft: focal length, aperture and real depth of field.",
	"authors": ["sajibsrs"],
	"contact": {
		"homepage": "https://github.com/sajibsrs/framecrafter",
		"sources": "https://github.com/sajibsrs/framecrafter",
		"issues": "https://github.com/sajibsrs/framecrafter/issues"
	},
	"license": "MIT",
	"icon": "assets/framecrafter/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["io.github.sajibsrs.framecrafter.Framecrafter"]
	},
	"mixins": ["framecrafter.mixins.json"],
	"depends": {
		"fabricloader": ">=0.20.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
